    "version": "0.2.0",
    "configurations": [
        {
            "name": "rawtypes.gen_cindex_stub",
            "type": "debugpy",
            "request": "launch",
            "env": {
                "PYTHONPATH": "src",
            },
            "module": "rawtypes.gen_cindex_stub",
            "args": [
                "typings"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "rawtypes.tree",
            "type": "debugpy",
            "request": "launch",
            "env": {
                "PYTHONPATH": "src",
            },
            "module": "rawtypes.tree",
            "args": [],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "generate zig module",
            "type": "debugpy",
            "request": "launch",
            "module": "rawtypes.generator",
            "args": [
                "--src",
                // "${env:GLFW_DIR}/include/GLFW/glfw3.h",
                "C:/Program Files/LLVM/include/clang-c/Index.h",
                // "${env:RAYLIB_DIR}/raylib.h",
                "--include",
                "C:/Program Files/LLVM/include",
                "--dst",
                "zig/main.zig",
            ]
        },
        {
            "name": "----"
        },
        {
            "name": "setup.py sdist",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/setup.py",
            "args": [
                "sdist",
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
    ]
}